{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mfsys-news-publisher",
  "main": "workers/news-publisher.mjs",
  "compatibility_date": "2026-09-18",
  "triggers": {
    "crons": ["0 16 * * *", "0 17 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ]
}
